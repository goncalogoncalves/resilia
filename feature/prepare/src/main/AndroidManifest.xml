<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Optional medical-sheet lock (decision §6.2). Normal permission: granted at install, never asked. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application>
        <!-- Shares the generated PDFs (decision §6.3 of marco-4-fontes.md). No storage permission. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.paper"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/paper_paths" />
        </provider>
    </application>
</manifest>
