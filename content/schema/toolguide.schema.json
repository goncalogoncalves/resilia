{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resilia.local/schema/toolguide.schema.json",
  "title": "Tool guide",
  "type": "object",
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "title": { "$ref": "common.schema.json#/$defs/localizedText" },
    "summary": { "$ref": "common.schema.json#/$defs/localizedText" },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "scenario.schema.json#/$defs/step" } },
    "sourceIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" } },
    "review": { "$ref": "common.schema.json#/$defs/review" }
  },
  "required": ["id", "title", "summary", "steps", "review"],
  "additionalProperties": false
}
