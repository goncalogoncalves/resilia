{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resilia.local/schema/common.schema.json",
  "title": "Common definitions",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "localizedText": {
      "type": "object",
      "properties": {
        "pt-PT": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      },
      "required": ["pt-PT", "en"],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "status": { "enum": ["draft", "reviewed"] },
        "reviewedAt": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "reviewedBy": { "type": ["string", "null"] }
      },
      "required": ["status"],
      "additionalProperties": false
    }
  }
}
