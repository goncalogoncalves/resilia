{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resilia.local/schema/hospitals.schema.json",
  "title": "SNS hospitals with an emergency department (generated by tools/data/sns_urgencias.py)",
  "type": "object",
  "properties": {
    "sourceIds": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/id" },
      "minItems": 1
    },
    "dataModified": { "$ref": "common.schema.json#/$defs/date" },
    "retrievedAt": { "$ref": "common.schema.json#/$defs/date" },
    "hospitals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "name": { "type": "string", "minLength": 1 },
          "group": { "type": "string" },
          "urgency": { "enum": ["polyvalent-trauma", "polyvalent", "medical-surgical", "basic"] },
          "address": { "type": "string", "minLength": 1 },
          "postalCode": { "type": "string", "pattern": "^\\d{4}-\\d{3}$" },
          "locality": { "type": "string", "minLength": 1 },
          "region": { "type": "string", "minLength": 1 }
        },
        "required": ["id", "name", "group", "urgency", "address", "postalCode", "locality", "region"],
        "additionalProperties": false
      }
    },
    "review": { "$ref": "common.schema.json#/$defs/review" }
  },
  "required": ["sourceIds", "dataModified", "retrievedAt", "hospitals", "review"],
  "additionalProperties": false
}
