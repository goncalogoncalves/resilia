{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resilia.local/schema/activities.schema.json",
  "title": "Screen-free activities",
  "type": "object",
  "properties": {
    "activities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/activity" }
    }
  },
  "required": ["activities"],
  "additionalProperties": false,
  "$defs": {
    "activity": {
      "type": "object",
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "type": { "enum": ["game", "stories", "calm", "challenge"] },
        "title": { "$ref": "common.schema.json#/$defs/localizedText" },
        "summary": { "$ref": "common.schema.json#/$defs/localizedText" },
        "ageMin": { "type": "integer", "minimum": 0, "maximum": 99 },
        "ageMax": { "type": "integer", "minimum": 0, "maximum": 99 },
        "peopleMin": { "type": "integer", "minimum": 1 },
        "peopleMax": { "type": "integer", "minimum": 1 },
        "materials": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" }, "uniqueItems": true },
        "durationMin": { "type": "integer", "minimum": 1 },
        "setting": { "enum": ["indoor", "outdoor", "both"] },
        "noise": { "enum": ["quiet", "moderate", "loud"] },
        "light": { "enum": ["none", "torch", "light"] },
        "instructions": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/localizedText" } },
        "variants": { "$ref": "common.schema.json#/$defs/localizedText" },
        "origin": { "enum": ["original", "traditional", "public-domain", "guidance"] },
        "originNote": { "$ref": "common.schema.json#/$defs/localizedText" },
        "sourceIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" } },
        "review": { "$ref": "common.schema.json#/$defs/review" }
      },
      "required": ["id", "type", "title", "summary", "ageMin", "peopleMin", "durationMin", "setting", "noise", "light", "instructions", "origin", "review"],
      "additionalProperties": false
    }
  }
}
