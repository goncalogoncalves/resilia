<?xml version="1.0" encoding="utf-8"?>
<!-- No unencrypted traffic at all (decision 4.1, milestone 7). Only system certificates. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
